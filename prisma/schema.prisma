generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TEACHER
  STUDENT
}

enum LessonType {
  REGULAR
  AD_HOC
  PRACTICE
  SOLO_ADDITIONAL
  DUET_ADDITIONAL
}

enum LessonStatus {
  BOOKED
  COMPLETED
  CANCELLED
  DRAFT
}

enum MenuCategory {
  REGULAR
  PRACTICE
  SOLO_ADDITIONAL
  DUET_ADDITIONAL
  OTHER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  lessonsAsStudent Lesson[] @relation("StudentLessons")
  lessonsAsTeacher Lesson[] @relation("TeacherLessons")
  availabilities   Availability[] @relation("StudentAvailability")
  monthlyAvailabilities MonthlyAvailability[] @relation("StudentMonthlyAvailability")
  cancellationCredits CancellationCredit[]
  publishedMonthlySchedules MonthlySchedulePublication[] @relation("MonthlySchedulePublishedBy")
  publishedClosedDaySchedules ClosedDayPublication[] @relation("ClosedDayPublishedBy")
  defaultLessonCount Int      @default(4) // Monthly contract lesson count
  assignedLessons    Lesson[] @relation("AssignedSupportStaff")

  @@index([role])
}

model MonthlyAvailability {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation("StudentMonthlyAvailability", fields: [studentId], references: [id])
  
  year      Int
  month     Int
  
  // JSON arrays of date-time strings (ISO format or similar) representing 30-min slots
  availableSlots   Json? // e.g., ["2023-10-01T10:00:00.000Z", ...]
  unavailableSlots Json? // e.g., ["2023-10-01T10:00:00.000Z", ...]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, year, month])
}

model Lesson {
  id        String       @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  type      LessonType   @default(REGULAR)
  status    LessonStatus @default(BOOKED)

  // Lesson Record Fields
  report     String?      // Teacher's note about the lesson (karte)
  homework   String?      // Homework assigned
  rating     Int?         // 1-5 Scale (optional)
    
  studentId String
  student   User         @relation("StudentLessons", fields: [studentId], references: [id])
  
  teacherId String?
  teacher   User?        @relation("TeacherLessons", fields: [teacherId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  menuId    String?
  menu      Menu?        @relation(fields: [menuId], references: [id])
  roomId    String?      // 'A' or 'B', useful for fixed lessons too
  assignedStaffId String?
  assignedStaff   User?  @relation("AssignedSupportStaff", fields: [assignedStaffId], references: [id])

  @@index([startTime])
  @@index([studentId, startTime])
  @@index([roomId, startTime])
}

model OpenSlot {
  id          String   @id @default(cuid())
  roomId      String   // 'A' or 'B'
  startTime   DateTime
  endTime     DateTime
  isBooked    Boolean  @default(false)
  isPublic    Boolean  @default(false) // Whether it's visible to students
  menuId      String?
  menu        Menu?    @relation(fields: [menuId], references: [id])
  durationMin Int      @default(30)

  @@index([startTime])
  @@index([roomId, startTime])
  @@index([isBooked, isPublic, startTime])
}

model SupportStaff {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shifts    SupportShift[]
}

model SupportShift {
  id        String       @id @default(cuid())
  staffId   String
  staff     SupportStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([startTime, endTime])
}

model Menu {
    id          String     @id @default(cuid())
    name        String     @unique
    category    MenuCategory @default(OTHER)
    durationMin Int
    price       Int        @default(0)
    description String?
    lessons     Lesson[]
    openSlots   OpenSlot[]
}

model MonthlySchedulePublication {
    id          String   @id @default(cuid())
    year        Int
    month       Int
    publishedAt DateTime @default(now())
    publishedBy String?
    teacher     User?    @relation("MonthlySchedulePublishedBy", fields: [publishedBy], references: [id])
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@unique([year, month])
}

model CancellationCredit {
    id        String   @id @default(cuid())
    studentId String
    student   User     @relation(fields: [studentId], references: [id])
    
    year      Int
    month     Int
    count     Int      @default(0) // Number of reschedule rights
    used      Int      @default(0) // Number used
    
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([studentId, year, month])
}

model Availability {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation("StudentAvailability", fields: [studentId], references: [id])

  days      Json      // Array of preferred days e.g. ["monday", "wednesday"]
  startTime String?   // General preferred start time e.g. "16:00"
  endTime   String?   // General preferred end time e.g. "19:00"
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClosedDay {
  id        String   @id @default(cuid())
  date      DateTime // Calendar date, normalized to midnight
  startTime String?  // "HH:mm" or null = whole day
  endTime   String?  // "HH:mm" or null = whole day
  reason    String?  // e.g. "祝日", "発表会準備"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@unique([date, startTime, endTime])
}

model ClosedDayPublication {
  id          String   @id @default(cuid())
  year        Int
  month       Int
  publishedAt DateTime @default(now())
  publishedBy String?
  teacher     User?    @relation("ClosedDayPublishedBy", fields: [publishedBy], references: [id])
  publishedClosedDays PublishedClosedDay[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([year, month])
}

model PublishedClosedDay {
  id            String               @id @default(cuid())
  publicationId String
  publication   ClosedDayPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  date          DateTime
  startTime     String?
  endTime       String?
  reason        String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([date])
  @@unique([publicationId, date, startTime, endTime])
}

model TeacherWorkingHour {
  id        String   @id @default(cuid())
  dayOfWeek Int      // 0-6 (Sun-Sat)
  timeRanges Json    // [{ startTime: "HH:mm", endTime: "HH:mm" }, ...]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek])
}
